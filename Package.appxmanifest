<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="FeedlyFeedProvider"
    Publisher="CN=FeedlyFeedProvider"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Feedly Feed Provider</DisplayName>
    <PublisherDisplayName>Feedly Feed Provider</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="FeedlyFeedProvider.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Feedly Feed Provider"
        Description="A feed provider that displays Feedly feeds in Microsoft Widgets"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.windows.feed"
            DisplayName="Feedly Feed Provider"
            Id="FeedlyFeedProvider">
            <uap3:Properties>
              <FeedProvider>
                <Activation>
                  <CreateInstance ClassId="F3C06D85-4B8A-4E9C-9F1A-2D3E5C6B7A8D" />
                </Activation>
                <Feeds>
                  <Feed Id="FeedlyFeed" ContentUri="https://feedly.com/feed.json" />
                </Feeds>
              </FeedProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
