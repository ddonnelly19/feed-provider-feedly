# Example .env file for Feedly Feed Provider
# Copy this file to .env and fill in your values

# Your Feedly API access token
# Get this from https://developers.feedly.com
FEEDLY_ACCESS_TOKEN=your-access-token-here

# The Feedly stream ID to fetch
# Examples:
#   - user/YOUR_USER_ID/category/global.all (all items)
#   - user/YOUR_USER_ID/category/tech (tech category)
#   - feed/http://example.com/rss (specific feed)
FEEDLY_STREAM_ID=user/YOUR_USER_ID/category/global.all

# Number of feed items to fetch and display
FEEDLY_FEED_COUNT=10
